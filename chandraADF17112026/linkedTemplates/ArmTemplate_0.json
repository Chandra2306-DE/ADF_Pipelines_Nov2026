						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@variables('Filelist')",
								"type": "Expression"
							},
							"condition": {
								"value": "@and(equals(item().type,'file' ),endswith(toLower(item().name),'.json'))",
